# syntax=docker/dockerfile:1

# ── build ────────────────────────────────────────────────────────────────────
# Node 24: package-lock.json was generated by the npm 11 it ships with, and
# npm 10 rejects the lock as out of sync (see .github/workflows/ci.yml).
FROM node:24-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build


# ── runtime ──────────────────────────────────────────────────────────────────
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

# nginx's entrypoint renders templates/*.template through envsubst at startup,
# which is how BACKEND_ORIGIN reaches the proxy_pass directive.
ENV BACKEND_ORIGIN=http://backend:8000
COPY nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

# 127.0.0.1, not localhost: inside the container localhost resolves to ::1 first
# and nginx's `listen 8080` binds IPv4 only, so busybox wget gets ECONNREFUSED
# and the container reports unhealthy while actually serving fine.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1
