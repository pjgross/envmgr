# Copy to backend/.env for local development:  cp .env.example .env
#
# DEBUG=true is what allows the repo's placeholder SECRET_KEY to be used. Any
# deployment with DEBUG=false must set a real SECRET_KEY or the app refuses to
# start — see app/core/config.py.

DEBUG=true

# Required when DEBUG=false. Generate with: openssl rand -hex 32
# SECRET_KEY=

# DATABASE_URL=postgresql+asyncpg://envmgr:envmgr_dev_password@localhost:5432/envmgr
# REDIS_URL=redis://localhost:6379
# NATS_URL=nats://localhost:4222

# Local AI test server (LiteLLM gateway on the ai-mini, home LAN only) — see
# CLAUDE.md "Local AI test server". Leave AI_BASE_URL unset to run with AI
# features off. Always the IP: `ai-mini.local` is not reachable from containers.
# AI_BASE_URL=http://192.168.1.253:4000/v1
# AI_API_KEY=local
# AI_CHAT_MODEL=copilot-chat
# AI_AGENT_MODEL=copilot-agent
# AI_FAST_MODEL=copilot-fast
# AI_EMBED_MODEL=embed
# AI_EMBED_DIMENSIONS=4096
# AI_TIMEOUT_SECONDS=120
