# Copy to backend/.env for local development:  cp .env.example .env
#
# DEBUG=true is what allows the repo's placeholder SECRET_KEY to be used. Any
# deployment with DEBUG=false must set a real SECRET_KEY or the app refuses to
# start — see app/core/config.py.

DEBUG=true

# Required when DEBUG=false. Generate with: openssl rand -hex 32
# SECRET_KEY=

# DATABASE_URL=postgresql+asyncpg://envmgr:envmgr_dev_password@localhost:5432/envmgr
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=envmgr_dev_password
# REDIS_URL=redis://localhost:6379
# NATS_URL=nats://localhost:4222
